# Track all files except common secrets and local credential stores.
# Filename rules cannot detect secrets embedded in ordinary files.

# Local environment secrets; sanitized templates remain trackable.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Private keys and key stores.
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_ecdsa_sk
id_ed25519_sk
.ssh/
.gnupg/

# Authentication files and cloud credentials.
.netrc
_netrc
.git-credentials
.npmrc
.pypirc
.aws/
.azure/
.kube/
**/.config/gcloud/
application_default_credentials.json
credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml
secrets.toml
service-account*.json
service_account*.json
*-firebase-adminsdk-*.json
*.tfstate
*.tfstate.*
